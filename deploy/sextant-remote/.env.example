# Template only. Values stay empty in git.
# Copy to /etc/fortress/sextant-remote-edge.env on the Contabo host,
# owner root, group root, mode 0600. Never commit the copy.
#
# OAUTH2_PROXY_CLIENT_SECRET is generated by Keycloak for the confidential
# client sextant-remote and is stored by FortressPhronesis. Do not invent one
# in this file.
OAUTH2_PROXY_CLIENT_SECRET=

# 16, 24, or 32 byte cookie secret. Generate it on the host and write it only
# into the host env file. docs/sextant-remote.md has the command that stores
# `openssl rand -base64 32` without printing it. Do not commit the result.
OAUTH2_PROXY_COOKIE_SECRET=
