graph TD

%% ─── USER TRAFFIC ───────────────────────────────
U["🌐 User Browser (pericopeai.com)"] -->|HTTPS 443| NGINX

%% ─── NGINX REVERSE PROXY (HOST) ──────────────
subgraph NGINX["🧭 NGINX Reverse Proxy (Host, Contabo)"]
    N1["Ports 80/443 on 89.117.151.145"]
    N2["/etc/nginx/sites-available/pericopeai.conf → routing"]
    N3["/etc/letsencrypt/ → SSL certificates"]
    N4["location / → proxy_pass http://127.0.0.1:13080 (FE container)"]
    N5["location /api → proxy_pass http://127.0.0.1:18000 (API container)"]
    N6["location /auth → proxy_pass https://auth.pericopeai.com"]
end

%% ─── FRONTEND (CONTAINER) ─────────────────────────
subgraph FRONTEND["🎨 pericopeai-frontend (container)"]
    F1["Build from /root/workspace/AugustineFE"]
    F2["nginx inside container on :80 → host :13080"]
end

NGINX -->|proxies / to FE| F1

%% ─── FASTAPI BACKEND (CONTAINER) ─────────────
subgraph FASTAPI["⚙️ pericopeai-api (container)"]
    B1["/root/workspace/AugustineService → uvicorn on :8080 → host :18000"]
    B2["routes/auth.py → OIDC exchange"]
    B3["routes/chat.py → Chat and RAG endpoints"]
    B4[".env → DB creds (local MySQL), OIDC config"]
    B5["CORPUS_API_URL → http://augustine-corpus-1-0-0:8001"]
end

NGINX -->|proxy /api| FASTAPI

%% ─── CORPUS SERVICE ──────────────────────────
subgraph CORPUS["📚 Augustine Corpus (container)"]
    C1["augustine-corpus-1-0-0 → port 8001"]
    C2["Indexes volume: corpus_indexes"]
end

%% ─── DATABASE (CONTAINER) ─────────────────-----
subgraph DB["🗄️ MySQL (container)"]
    D1["mysql:8.0 → port 3306 (host-mapped as 3307)"]
    D2["Volume: mysql_data"]
end

FASTAPI -->|SQLAlchemy ORM| DB
FASTAPI -->|Corpus calls| CORPUS

%% ─── KEYCLOAK INSTANCES ─────────────────────────
subgraph KC["🔐 Keycloak (Two runtimes present)"]
    K1["Host Java → 8080 (active)"]
    K2["Docker container → 8081 (duplicate)"]
    K3["/opt/keycloak/data/realms/pericope.json → Realm config"]
    K4["/opt/keycloak/themes/pericope/ → Custom login theme"]
    K5["/opt/keycloak/conf/keycloak.conf → Server config"]
end

FASTAPI -->|POST /token| KC
U -->|Redirect /auth| KC

%% ─── NETWORKING ─────────────────────────────────
subgraph NET["🕸️ Host networking (Contabo)"]
    NGINX -.->|localhost| FASTAPI
    FASTAPI -.->|localhost| CORPUS
    FASTAPI -.->|fortress-phronesis-net| DB
    KC -.->|8080/8081| NGINX
    NGINX -.->|public| U
end

%% ─── FOLDER SUMMARY NODES ───────────────────────
subgraph SUMMARY["📂 Folder → Function Mapping"]
    S1["/etc/nginx/ → Reverse proxy + SSL configuration"]
    S2["/var/www/pericopeai/ → Frontend build and static assets"]
    S3["/var/www/pericopeai.com/AugustineService/ → FastAPI backend codebase"]
    S4["mysql_data → local DB persistence"]
    S5["/opt/keycloak/ → Identity provider realm + theme"]
    S6["Corpus service (AugustineCorpus compose) → port 8001"]
end

NGINX --> S1
FRONTEND --> S2
FASTAPI --> S3
DB --> S4
KC --> S5
CORPUS --> S6
