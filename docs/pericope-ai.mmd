graph TD

%% ─── ENTRYPOINTS ─────────────────────────────
A1["🌐 pericopeai.com (Frontend + /api path)"]
A2["🔐 auth.pericopeai.com (Keycloak realm)"]

%% ─── NGINX CONFIGURATION ─────────────────────
subgraph S1["🧭 /etc/nginx/sites-available/pericopeai.conf (host)"]
  S1a["location / → proxy_pass 127.0.0.1:13080 (FE container)"]
  S1b["location /api → proxy_pass 127.0.0.1:18000 (API container)"]
end

A1 --> S1
A2 -->|OIDC authority| S1

%% ─── FRONTEND (CONTAINER) ─────────────────────
subgraph S2["🎨 pericopeai-frontend container"]
  S2a["build from /root/workspace/AugustineFE"]
  S2b["nginx in-container on :80 → mapped to host :13080"]
end

S1a --> S2a

%% ─── BACKEND (CONTAINER) ─────────────────────
subgraph S3["⚙️ pericopeai-api container"]
  S3a["main.py (FastAPI uvicorn) on :8080 → host :18000"]
  S3b["routes/auth.py, routes/chat.py"]
  S3c[".env → DB creds (local MySQL), OIDC vars"]
  S3d["CORPUS_API_URL → http://augustine-corpus-1-0-0:8001"]
end

S1b --> S3a
S3a -->|OIDC| A2
S3a -->|corpus/search| S4a

%% ─── CORPUS SERVICE ──────────────────────────
subgraph S4["📚 Augustine Corpus (container)"]
  S4a["augustine-corpus-1-0-0 → port 8001"]
  S4b["Indexes volume: corpus_indexes"]
end

%% ─── DATABASE ────────────────────────────────
subgraph S5["🗄️ MySQL (container)"]
  S5a["mysql:8.0 → port 3306 (host-mapped as 3307)"]
  S5b["Volume: mysql_data"]
end

S3a -->|SQLAlchemy| S5

%% ─── AUTH SERVER ─────────────────────────────
subgraph S6["🔐 Keycloak (two instances present)"]
  S6a["Host Java → 8080"]
  S6b["Docker → 8081 (auth-keycloak-1)"]
end

A2 --> S6a
S3a --> S6a

%% ─── LOGICAL FLOW ────────────────────────────
User["User Browser"] -->|visit pericopeai.com| A1
User -->|login redirect| A2
A1 -->|/api calls| S3a
S3a -->|persist| S5
S6a -->|tokens| S3a
S3a -->|corpus calls| S4a
